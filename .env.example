# Configure these server-side values in Vercel; never commit real credentials.

# Optional database destination
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Existing Telegram notification destination
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Server-only Omnisend key with events.write. Never put this key in public assets.
OMNISEND_API_KEY=
# Set true only after both delivery workflows are enabled and tested.
OMNISEND_GUIDE_READY=false
