{
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/klaviyo-agency/",
      "destination": "/omnisend-agency/",
      "statusCode": 301
    },
    {
      "source": "/klaviyo-agency/:path*/",
      "destination": "/omnisend-agency/",
      "statusCode": 301
    }
  ]
}
